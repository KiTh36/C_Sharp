<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FilmsApp.MainPage"
    Title="Films">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            Text="Movie Search"
            FontSize="28"
            FontAttributes="Bold" />

        <HorizontalStackLayout Spacing="10">

            <Entry
                x:Name="SearchEntry"
                Placeholder="Enter movie title"
                HorizontalOptions="FillAndExpand" />

            <Button
                Text="Search"
                Clicked="OnSearchClicked" />

        </HorizontalStackLayout>

        <ActivityIndicator
            x:Name="LoadingIndicator"
            IsRunning="False"
            IsVisible="False" />

        <CollectionView
            x:Name="MoviesList"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <VerticalStackLayout Padding="5" Spacing="4">

                        <Label
                            Text="{Binding Title}"
                            FontSize="20"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding ReleaseDate}"
                            FontSize="14" />

                        <Label
                            Text="{Binding VoteAverage, StringFormat='TMDB rating: {0:F1}'}"
                            FontSize="14" />

                        <Label
                            Text="{Binding Overview}"
                            FontSize="14"
                            LineBreakMode="TailTruncation"
                            MaxLines="3" />

                    </VerticalStackLayout>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>